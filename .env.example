# Copy to .env (local) or paste into Dokploy's Environment tab.

# Database password. Use letters and digits only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs media URLs. At least 32 characters; changing it invalidates media links:
#   openssl rand -hex 32
STARBOORU_SECRET=

# The version to run, such as 0.1.0-beta.1. Unset: the newest release.
# STARBOORU_VERSION=

# Shown on the sign-in screen.
STARBOORU_NAME=StarBooru

# The first account becomes admin. Leave this off afterwards unless others
# should be able to create accounts.
STARBOORU_ALLOW_REGISTRATION=false

# Sign-in with an OpenID Connect provider (Authentik, Keycloak, Google...).
# Leave empty to use passwords only. Redirect URI to register at the provider:
#   https://your-domain/api/v1/auth/oidc/callback
STARBOORU_PUBLIC_URL=
STARBOORU_OIDC_ISSUER=
STARBOORU_OIDC_CLIENT_ID=
STARBOORU_OIDC_CLIENT_SECRET=
STARBOORU_OIDC_NAME=SSO

# Largest accepted upload, in MiB. Behind a proxy, its body limit applies too.
STARBOORU_MAX_UPLOAD_MB=512

# Smaller JPEG copies of big images (1 MiB and up) for the viewer; originals stay untouched.
STARBOORU_SAMPLES=true

# Tag posts with what the file shows (highres, lowres, video, sound, ...), once per post.
STARBOORU_AUTO_TAGS=true
# Text in images (OCR) with tesseract, on the server only, for text: search.
# Languages are joined with +; the image has English and Japanese (jpn across,
# jpn_vert down, for manga). Fewer languages read faster (see the Dockerfile).
STARBOORU_OCR=true
STARBOORU_OCR_LANGS=eng+jpn+jpn_vert

# Purge recycle-bin posts after this many days (0 keeps them until you empty the bin).
STARBOORU_TRASH_DAYS=0

# Database backups (into STARBOORU_DATA_DIR/backups): every this many days
# (0 turns automatic backups off), keeping this many. Admins can change both in the app.
STARBOORU_BACKUP_DAYS=1
STARBOORU_BACKUP_KEEP=7

# ffmpeg and ffprobe make thumbnails for video, AVIF and JPEG XL. The Docker image
# includes them; set STARBOORU_FFMPEG=off to disable.
# STARBOORU_FFMPEG=ffmpeg
# STARBOORU_FFPROBE=ffprobe

# Import from URL: on (public addresses only), private (also your LAN), or off.
# STARBOORU_URL_IMPORT=on

# AI runs on this server or through any OpenAI-compatible API, chosen for each
# tool in the admin panel (Admin > Server > AI). These only set what a new
# install starts with. An API receives thumbnails and the text being translated.
# STARBOORU_AI_URL=https://openrouter.ai/api/v1
# STARBOORU_AI_MODEL=google/gemini-2.5-flash-lite
# STARBOORU_AI_KEY=
# STARBOORU_AI_AUTOTAG=false
# STARBOORU_LOCAL_AI=false

# Where each tool starts: off, local or api. Unset: api when the URL is set,
# else local when STARBOORU_LOCAL_AI is on.
# STARBOORU_AI_TAGGING=
# STARBOORU_AI_TRANSLATION=
# STARBOORU_AI_COMICS=
# Translate new images in which OCR finds text (comic and manga pages) into this
# language, drawn over the picture. Empty: only when someone asks in the viewer.
# STARBOORU_AI_TRANSLATE_TO=en
