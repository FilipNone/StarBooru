# Copy to .env (local) or paste into Dokploy's Environment tab.

# Database password. Use letters and digits only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs media URLs. At least 32 characters; changing it invalidates media links:
#   openssl rand -hex 32
STARBOORU_SECRET=

# Shown on the sign-in screen.
STARBOORU_NAME=StarBooru

# The first account becomes admin. Leave this off afterwards unless others
# should be able to create accounts.
STARBOORU_ALLOW_REGISTRATION=false

# Largest accepted upload, in MiB. Behind a proxy, its body limit applies too.
STARBOORU_MAX_UPLOAD_MB=512
